{
  "name": "openharmony-smart-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:control-center": "npm run dev --workspace @smart-home/control-center",
    "dev:mqtt-gateway": "npm run dev --workspace @smart-home/mqtt-gateway",
    "test:mqtt:integration": "npm run test:mqtt:integration --workspace @smart-home/control-center",
    "security:migrate:check": "npm run security:migrate:check --workspace @smart-home/control-center --",
    "security:migrate": "npm run security:migrate --workspace @smart-home/control-center --"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
