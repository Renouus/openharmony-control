DEVICE_PROVIDER=simulator
CONTROL_CENTER_PORT=3443
CONTROL_CENTER_HOST=0.0.0.0
DATABASE_PATH=smarthome.db

# Switch to Tuya mode by changing DEVICE_PROVIDER to tuya and filling the values below.
# DEVICE_PROVIDER=tuya
# TUYA_BASE_URL=https://openapi.tuyacn.com
# TUYA_ACCESS_ID=your-access-id
# TUYA_ACCESS_SECRET=your-access-secret
# TUYA_LIGHT_DEVICE_ID=vdevo178318782505115
# TUYA_LIGHT_NAME=Ceiling lighting
# TUYA_LIGHT_ROOM=living-room

# Switch to MQTT mode by changing DEVICE_PROVIDER to mqtt and filling the service credentials below.
# DEVICE_PROVIDER=mqtt
# MQTT_BROKER_URL=mqtt://127.0.0.1:1883
# MQTT_GATEWAY_ID=home-gateway-1
# MQTT_CLIENT_ID=omnihome-control-center
# MQTT_CONTROL_CENTER_USERNAME=your-control-center-username
# MQTT_CONTROL_CENTER_PASSWORD=your-local-control-center-password
# MQTT_COMMAND_TIMEOUT_MS=3000
# MQTT_GATEWAY_OFFLINE_AFTER_MS=15000
